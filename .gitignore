# Claude Code / plugin local data (never commit)
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
uv.lock.bak

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Project data and outputs (cached, not versioned)
data/*
!data/.gitkeep
results/*
!results/.gitkeep

# `data/*` above has no leading slash, so it matches ANY directory named data at
# any depth. The exported site payloads live in such directories and MUST ship, or
# the Vercel build fails on a missing import. Re-include them explicitly.
!monitor/data/*.json
!ledger/public/data/*.json

# Node / Next (the ledger app)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Vercel CLI link artifacts
.vercel

# Env / secrets
.env
*.local
