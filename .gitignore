# Claude Code / plugin local data (never commit)
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
uv.lock.bak

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Project data and outputs (cached, not versioned)
data/*
!data/.gitkeep
results/*
!results/.gitkeep

# `data/*` does NOT match every directory named data. A pattern with a slash anywhere
# but the end is anchored to this file's directory, so `data/*` matches the repo-root
# `data/` only. Measured: `git check-ignore -v docs/data/x` and `monitor/data/x` both
# report NOT IGNORED. That anchoring, not the two re-includes below, is what lets the
# exported site payloads ship. The re-includes are kept as documentation of intent and
# as a guard if `data/*` is ever rewritten as `**/data/*`, which WOULD catch them and
# would break the Vercel build on a missing import.
!monitor/data/*.json
!ledger/public/data/*.json

# Node / Next (the ledger app)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Vercel CLI link artifacts
.vercel

# Env / secrets
.env
*.local
